<footer class="site-footer">
  <div class="container">
    <hr class="rule">
    <div class="site-footer__inner">
      <a class="wordmark" href="/">Therefore Tech</a>
      <nav aria-label="Footer">
        <ul class="site-footer__list" role="list">
          {%- for item in nav.footer %}
          <li><a href="{{ item.url }}">{{ item.label }}</a></li>
          {%- endfor %}
          {%- if site.linkedin %}
          <li><a href="{{ site.linkedin }}" rel="me">LinkedIn</a></li>
          {%- endif %}
        </ul>
      </nav>
      <div class="site-footer__meta t-caption">
        <p>© {{ buildYear }} Therefore Tech</p>
        <p>The innovation arm for founders.</p>
      </div>
    </div>
  </div>
</footer>
