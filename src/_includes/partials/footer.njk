<footer class="site-footer">
  <hr class="rule">
  <div class="container grid site-footer__inner">
    <p class="site-footer__brand"><a href="/">Therefore Tech</a></p>
    <nav class="site-footer__nav" aria-label="Footer">
      <ul class="site-footer__list" role="list">
        {%- for item in nav.footer %}
        <li><a href="{{ item.url }}">{{ item.label }}</a></li>
        {%- endfor %}
        {%- if site.founderLinkedin %}
        <li><a href="{{ site.founderLinkedin }}" rel="me">LinkedIn</a></li>
        {%- endif %}
      </ul>
    </nav>
    <div class="site-footer__meta t-caption">
      <p>© {{ buildYear }} Therefore Tech</p>
      <p>The innovation arm for founders.</p>
    </div>
  </div>
</footer>
