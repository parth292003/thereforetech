<form class="contact-form" action="#" method="post">
  {%- for f in home.contact.fields %}
  <p>
    <label for="f-{{ f.name }}">{{ f.label }}</label><br>
    <input id="f-{{ f.name }}" name="{{ f.name }}" type="{{ f.type }}" autocomplete="{{ f.autocomplete }}"{% if f.required %} required{% endif %}>
  </p>
  {%- endfor %}
  <p><button class="btn btn--primary" type="submit" disabled>{{ home.contact.submitLabel }}</button></p>
  <p class="t-small t-muted">The form is not connected yet (Phase 8).</p>
</form>
